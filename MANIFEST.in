include README.md
include LICENSE
include THIRD_PARTY_NOTICES.md
include CITATION.cff AUTHORS.md CHANGELOG.md RELEASE_NOTES.md DATASETS.md
include AUTHORSHIP_APPROVAL_REQUIRED.md
recursive-include requirements *.txt
recursive-include scripts *.py
recursive-include core_sg *.py *.pyx *.h
prune build
global-exclude *.so
global-exclude *.pyd
global-exclude *.dll
recursive-include tests *.py
recursive-include benchmarks *.py
recursive-include benchmarking *.py
prune benchmarking/missing_edges/results
prune dist
prune .venv
prune .git
prune .pytest_cache
global-exclude *.csv *.npy *.npz *.pyc *.pyo .DS_Store
# Regenerated by Cython in the isolated build; generated C embeds local paths.
global-exclude *.c
